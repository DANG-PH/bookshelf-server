# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000
# Public base URL this API is reachable at once deployed (no trailing slash).
# Used to build absolute file links (PDF/cover) returned by GET /api/catalog.
# Leave empty for local dev — links will just be relative "/api/files/...".
PUBLIC_URL=

# ── Database — postgres or mysql, whichever you spin up ──
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=tech_books

# ── Auth ──
# JWT_SECRET: any long random string (`openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Admin PIN for admin.html (reading the library needs no login). Set ONE of:
#  - AUTH_PIN: plain PIN, simplest for local dev.
#  - AUTH_PIN_HASH: bcrypt hash of the PIN, safer for anything public-facing.
#    Generate with: node -e "console.log(require('bcryptjs').hashSync('<pin>', 12))"
# Both accept a comma-separated list, so several admin PINs can be valid.
AUTH_PIN=change-me
# AUTH_PIN_HASH=

# ── CORS — set to your frontend's exact origin in production ──
# e.g. https://book.dangpham.id.vn
CORS_ORIGIN=*

# ── File storage ──
UPLOAD_DIR=./uploads

# ── Optional: Discord webhook for access notifications ──
# Leave empty to disable. Sends time, device, IP and rough city-level
# location for: anyone calling the API (once per device per 2 hours),
# and every successful/failed admin PIN login.
DISCORD_WEBHOOK_URL=

# Backup - Restore
POSTGRES_CONTAINER=postgres1
PG_USER=admin
PG_DB=book_db
PG_PASS=haidang
GITHUB_BACKUP_DIR=/root/bookshelf-server/backup/github-data/data
GITHUB_REPO_SSH=git@github.com:DANG-PH/book-db-backups.git
LOCAL_RETENTION_DAYS=7
CRON_HOUR=4
CRON_MINUTE=0