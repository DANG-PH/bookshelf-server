# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000
# Public base URL this API is reachable at once deployed (no trailing slash).
# Used to build absolute file links (PDF/cover) returned by GET /api/catalog.
# Leave empty for local dev — links will just be relative "/api/files/...".
PUBLIC_URL=

# ── Database — postgres or mysql, whichever you spin up ──
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=tech_books

# ── Auth ──
# JWT_SECRET: any long random string (`openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# PIN to enter the site. Set ONE of the two:
#  - AUTH_PIN: plain 6-digit PIN, simplest for local dev.
#  - AUTH_PIN_HASH: bcrypt hash of the PIN, safer for anything public-facing.
#    Generate with: node -e "console.log(require('bcryptjs').hashSync('010826', 12))"
AUTH_PIN=010826
# AUTH_PIN_HASH=

# ── CORS — set to your frontend's exact origin in production ──
# e.g. https://book.dangpham.id.vn
CORS_ORIGIN=*

# ── File storage ──
UPLOAD_DIR=./uploads

# ── Optional: Discord webhook for login notifications ──
# Leave empty to disable. Fires a message (time, device, IP, rough
# city-level location) on every successful/failed PIN login.
DISCORD_WEBHOOK_URL=

# ── Optional: library chatbot (RAG over the PDFs already in the library) ──
# Leave GEMINI_API_KEY empty and POST /ai/ask just replies that the
# chatbot isn't turned on yet — nothing else breaks. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional system prompt override — a sensible Vietnamese default is
# used if this is left blank.
AI_SYSTEM_PROMPT=

# Backup - Restore
GITHUB_REPO_SSH=